{
  "name": "Comptoir du Chef — Notification Réservation",
  "nodes": [
    {
      "id": "node-webhook",
      "name": "Webhook Réservation",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "comptoir-reservation",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      }
    },
    {
      "id": "node-code",
      "name": "Préparer données",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300],
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\nconst prenom   = (body.prenom   || '').trim();\nconst nom      = (body.nom      || '').trim();\nconst email    = (body.email    || '').trim();\nconst tel      = (body.tel      || '').trim();\nconst date     = (body.date     || '').trim();\nconst service  = (body.service  || '').trim();\nconst couverts = (body.couverts || '').trim();\nconst notes    = (body.notes    || '').trim();\n\nconst servicesLabels = {\n  dejeuner:    'Déjeuner (12h00)',\n  diner:       'Dîner (19h30)',\n  degustation: 'Menu Dégustation (20h00)'\n};\nconst serviceLabel = servicesLabels[service] || service || 'Non précisé';\n\n// Formater la date jj/mm/aaaa\nlet dateFormatee = date;\nif (date && date.includes('-')) {\n  const [annee, mois, jour] = date.split('-');\n  dateFormatee = `${jour}/${mois}/${annee}`;\n}\n\nconst couvertsLabel = couverts === '1' ? '1 personne' : `${couverts} personnes`;\n\nconst dateReception = new Date().toLocaleDateString('fr-FR', {\n  weekday: 'long',\n  year: 'numeric',\n  month: 'long',\n  day: 'numeric',\n  hour: '2-digit',\n  minute: '2-digit',\n  timeZone: 'Europe/Paris'\n});\n\nreturn [{\n  json: {\n    prenom,\n    nom,\n    email,\n    tel,\n    date,\n    dateFormatee,\n    service,\n    serviceLabel,\n    couverts,\n    couvertsLabel,\n    notes,\n    nomComplet: (prenom + ' ' + nom).trim(),\n    dateReception\n  }\n}];"
      }
    },
    {
      "id": "node-email-visiteur",
      "name": "Email confirmation visiteur",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [760, 180],
      "parameters": {
        "fromEmail": "ton.email@gmail.com",
        "toEmail": "={{ $json.email }}",
        "subject": "Demande de réservation reçue — Le Comptoir du Chef",
        "emailType": "html",
        "message": "<!DOCTYPE html><html><head><meta charset='UTF-8'></head><body style='background:#1a1a1a;margin:0;padding:40px 20px;font-family:Georgia,serif;'><div style='max-width:600px;margin:0 auto;background:#242424;border:1px solid rgba(201,168,76,0.3);border-radius:4px;overflow:hidden;'><div style='background:#1a1a1a;border-bottom:1px solid rgba(201,168,76,0.15);padding:32px 40px;text-align:center;'><p style='color:#c9a84c;font-size:11px;letter-spacing:3px;text-transform:uppercase;margin:0 0 8px;'>Restaurant Gastronomique · Paris</p><h1 style='color:#f5f0e8;font-size:26px;margin:0;font-weight:normal;font-family:Georgia,serif;'>Le Comptoir du Chef</h1><div style='width:40px;height:1px;background:#c9a84c;margin:16px auto 0;'></div></div><div style='padding:40px;'><p style='color:#c9a84c;font-size:11px;letter-spacing:2px;text-transform:uppercase;margin:0 0 20px;'>Demande de réservation</p><h2 style='color:#f5f0e8;font-weight:normal;font-size:21px;margin:0 0 20px;font-family:Georgia,serif;'>Bonjour {{ $json.prenom }},</h2><p style='color:#aaa;line-height:1.8;margin:0 0 24px;font-size:15px;'>Nous avons bien reçu votre demande de réservation. Notre équipe la confirme par email sous <strong style='color:#f5f0e8;'>24 heures</strong>.</p><div style='background:rgba(201,168,76,0.07);border:1px solid rgba(201,168,76,0.2);border-radius:4px;padding:24px;margin:0 0 28px;'><p style='color:#c9a84c;font-size:11px;letter-spacing:2px;text-transform:uppercase;margin:0 0 16px;'>Récapitulatif</p><table style='width:100%;border-collapse:collapse;'><tr><td style='padding:7px 0;color:#666;font-size:13px;width:130px;'>Date</td><td style='padding:7px 0;color:#f5f0e8;font-size:14px;font-weight:bold;'>{{ $json.dateFormatee }}</td></tr><tr><td style='padding:7px 0;color:#666;font-size:13px;'>Service</td><td style='padding:7px 0;color:#f5f0e8;font-size:14px;'>{{ $json.serviceLabel }}</td></tr><tr><td style='padding:7px 0;color:#666;font-size:13px;'>Couverts</td><td style='padding:7px 0;color:#f5f0e8;font-size:14px;'>{{ $json.couvertsLabel }}</td></tr><tr><td style='padding:7px 0;color:#666;font-size:13px;'>Téléphone</td><td style='padding:7px 0;color:#f5f0e8;font-size:14px;'>{{ $json.tel }}</td></tr></table></div><p style='color:#888;font-size:14px;line-height:1.8;margin:0 0 8px;'>En cas d'empêchement, merci de nous prévenir au minimum 24h à l'avance :</p><p style='color:#f5f0e8;margin:0;font-size:15px;'><strong style='color:#c9a84c;'>+33 1 42 60 15 80</strong> &nbsp;&middot;&nbsp; Du mardi au samedi, 10h–22h30</p></div><div style='background:#1a1a1a;border-top:1px solid rgba(201,168,76,0.1);padding:24px 40px;text-align:center;'><p style='color:#555;font-size:12px;margin:0 0 4px;'>24 Rue de la Paix, 75001 Paris &nbsp;&middot;&nbsp; Métro Opéra</p><p style='margin:0;'><a href='mailto:reservation@comptoir-chef.fr' style='color:#c9a84c;font-size:12px;text-decoration:none;'>reservation@comptoir-chef.fr</a></p></div></div></body></html>",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "1",
          "name": "SMTP — Comptoir du Chef"
        }
      }
    },
    {
      "id": "node-email-restaurant",
      "name": "Email notification restaurant",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [760, 420],
      "parameters": {
        "fromEmail": "ton.email@gmail.com",
        "toEmail": "ton.email@gmail.com",
        "subject": "={{ '🍽️ Nouvelle réservation — ' + $json.dateFormatee + ' · ' + $json.couvertsLabel + ' — ' + $json.nomComplet }}",
        "emailType": "html",
        "message": "<!DOCTYPE html><html><head><meta charset='UTF-8'></head><body style='background:#f0f0f0;margin:0;padding:40px 20px;font-family:Arial,sans-serif;'><div style='max-width:600px;margin:0 auto;background:white;border-radius:8px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,0.1);'><div style='background:#1a1a1a;padding:24px 32px;border-bottom:4px solid #c9a84c;'><h2 style='color:#c9a84c;margin:0;font-size:12px;letter-spacing:3px;text-transform:uppercase;'>Nouvelle demande de réservation</h2><p style='color:#888;margin:6px 0 0;font-size:13px;'>Le Comptoir du Chef — Formulaire site web</p></div><div style='padding:32px;'><div style='background:#f9f6ee;border:1px solid #e8d98a;border-radius:6px;padding:20px 24px;margin-bottom:24px;display:flex;gap:16px;'><div style='text-align:center;flex:1;border-right:1px solid #e8d98a;padding-right:16px;'><p style='color:#999;font-size:11px;text-transform:uppercase;letter-spacing:1px;margin:0 0 4px;'>Date</p><p style='color:#c9a84c;font-size:22px;font-weight:bold;margin:0;'>{{ $json.dateFormatee }}</p></div><div style='text-align:center;flex:1;border-right:1px solid #e8d98a;padding:0 16px;'><p style='color:#999;font-size:11px;text-transform:uppercase;letter-spacing:1px;margin:0 0 4px;'>Service</p><p style='color:#333;font-size:14px;font-weight:bold;margin:0;'>{{ $json.serviceLabel }}</p></div><div style='text-align:center;flex:1;padding-left:16px;'><p style='color:#999;font-size:11px;text-transform:uppercase;letter-spacing:1px;margin:0 0 4px;'>Couverts</p><p style='color:#333;font-size:22px;font-weight:bold;margin:0;'>{{ $json.couverts }}</p></div></div><table style='width:100%;border-collapse:collapse;font-size:14px;'><tr><td style='padding:11px 0;border-bottom:1px solid #f0f0f0;color:#999;width:130px;font-size:12px;text-transform:uppercase;letter-spacing:1px;font-weight:bold;'>Nom</td><td style='padding:11px 0;border-bottom:1px solid #f0f0f0;color:#111;font-weight:bold;font-size:15px;'>{{ $json.nomComplet }}</td></tr><tr><td style='padding:11px 0;border-bottom:1px solid #f0f0f0;color:#999;font-size:12px;text-transform:uppercase;letter-spacing:1px;font-weight:bold;'>Email</td><td style='padding:11px 0;border-bottom:1px solid #f0f0f0;'><a href='mailto:{{ $json.email }}' style='color:#c9a84c;text-decoration:none;'>{{ $json.email }}</a></td></tr><tr><td style='padding:11px 0;border-bottom:1px solid #f0f0f0;color:#999;font-size:12px;text-transform:uppercase;letter-spacing:1px;font-weight:bold;'>Téléphone</td><td style='padding:11px 0;border-bottom:1px solid #f0f0f0;color:#333;'>{{ $json.tel }}</td></tr><tr><td style='padding:11px 0;color:#999;font-size:12px;text-transform:uppercase;letter-spacing:1px;font-weight:bold;vertical-align:top;'>Notes</td><td style='padding:11px 0;color:#666;font-size:14px;line-height:1.7;'>{{ $json.notes || '—' }}</td></tr></table><div style='margin-top:28px;text-align:center;'><a href='mailto:{{ $json.email }}?subject=Confirmation de votre réservation — Le Comptoir du Chef&body=Bonjour {{ $json.prenom }},' style='display:inline-block;background:#c9a84c;color:white;padding:13px 30px;border-radius:4px;text-decoration:none;font-size:14px;font-weight:bold;'>Confirmer la réservation</a></div></div><div style='background:#f9f9f9;border-top:1px solid #eee;padding:16px 32px;text-align:center;'><p style='color:#ccc;font-size:11px;margin:0;'>Notification automatique · Workflow n8n · Le Comptoir du Chef</p><p style='color:#ccc;font-size:11px;margin:4px 0 0;'>Reçu le {{ $json.dateReception }}</p></div></div></body></html>",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "1",
          "name": "SMTP — Comptoir du Chef"
        }
      }
    },
    {
      "id": "node-respond",
      "name": "Réponse succès",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1020, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"success\": true, \"message\": \"Demande de réservation bien reçue. Confirmation par email sous 24h.\" }",
        "options": {
          "responseHeaders": {
            "entries": [
              { "name": "Access-Control-Allow-Origin", "value": "*" },
              { "name": "Content-Type", "value": "application/json" }
            ]
          }
        }
      }
    }
  ],
  "connections": {
    "Webhook Réservation": {
      "main": [[{ "node": "Préparer données", "type": "main", "index": 0 }]]
    },
    "Préparer données": {
      "main": [[{ "node": "Email confirmation visiteur", "type": "main", "index": 0 }]]
    },
    "Email confirmation visiteur": {
      "main": [[{ "node": "Email notification restaurant", "type": "main", "index": 0 }]]
    },
    "Email notification restaurant": {
      "main": [[{ "node": "Réponse succès", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Paris"
  }
}
